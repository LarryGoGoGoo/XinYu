page.data-v-82ce9c30 {
  --animate-duration: 1s;
  --animate-delay: 1s;
  --animate-repeat: 1;
}
.content.data-v-82ce9c30 {
  min-height: calc(100vh - 44px);
  box-sizing: border-box;
}
.seat-list.data-v-82ce9c30 {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  background: #FFFFFF;
  margin: 20rpx;
  border-radius: 20rpx;
  padding: 20rpx;
  font-size: 30rpx;
}
.seat-list .seat-item.data-v-82ce9c30 {
  width: 33.33%;
  display: flex;
  align-items: center;
  flex-direction: column;
  margin-bottom: 20rpx;
}

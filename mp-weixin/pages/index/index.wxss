.col3{color: #333;}
.col6{color: #666;}
.col9{color: #999;}
.colf{color: #fff;}
.colb{color: #bbb;}
/**间距**/
.elip{text-overflow: ellipsis;white-space: nowrap; overflow: hidden;}

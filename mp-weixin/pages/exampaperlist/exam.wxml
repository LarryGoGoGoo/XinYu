<view class="exam-page data-v-32950908"><view class="header-container data-v-32950908" style="{{'padding-top:'+(padTop+'px')+';'}}"><view data-event-opts="{{[['tap',[['leaveTap',['$event']]]]]}}" class="header-action data-v-32950908" bindtap="__e">退出</view><view class="header-center data-v-32950908"><view class="time data-v-32950908">{{SecondToDate}}</view><view class="progress data-v-32950908">{{currentIndex+1+"/"+$root.g0}}</view></view><view data-event-opts="{{[['tap',[['e0',['$event']]]]]}}" class="header-action data-v-32950908" bindtap="__e">答题卡</view></view><view class="progress-track data-v-32950908"><view class="progress-bar data-v-32950908" style="{{'width:'+(progressPercent+'%')+';'}}"></view></view><block wx:if="{{currentQuestion}}"><view class="question-card data-v-32950908"><view class="question-meta data-v-32950908"><text class="question-type data-v-32950908">{{$root.m0}}</text><text class="answered-count data-v-32950908">{{"已答 "+answeredCount+"/"+$root.g1}}</text></view><view class="question-title data-v-32950908"><rich-text nodes="{{currentQuestion.questionname}}" class="data-v-32950908"></rich-text></view><block wx:if="{{!isSubmit}}"><view class="answer-container data-v-32950908"><block wx:for="{{$root.l0}}" wx:for-item="option" wx:for-index="optionIndex" wx:key="code"><view data-event-opts="{{[['tap',[['selectOption',[optionIndex]]]]]}}" class="{{['answer-item','data-v-32950908',(option.m1)?'active':'']}}" bindtap="__e"><view class="option-code data-v-32950908">{{option.$orig.code}}</view><view class="option-text data-v-32950908">{{option.$orig.text}}</view></view></block><block wx:if="{{$root.m2}}"><view class="subjective-box data-v-32950908"><textarea class="subjective-input data-v-32950908" placeholder="{{currentQuestion.type==3?'请输入填空答案':'请输入答案'}}" auto-height="{{true}}" data-event-opts="{{[['blur',[['syncCurrentAnswer',['$event']]]],['input',[['__set_model',['$0','myanswer','$event',[]],['currentQuestion']]]]]}}" value="{{currentQuestion.myanswer}}" bindblur="__e" bindinput="__e"></textarea></view></block><block wx:if="{{$root.m3}}"><view class="empty-options data-v-32950908"> 当前题目暂无可选项，请返回题库检查选项配置 </view></block></view></block><block wx:if="{{isSubmit&&isEndFlag}}"><view class="tip-container data-v-32950908"><view class="par data-v-32950908">{{"我的答案："+(currentQuestion.myanswer||'未作答')}}</view><view class="par data-v-32950908">{{"题目分析："+(currentQuestion.analysis||'暂无解析')}}</view></view></block></view></block><block wx:if="{{!isSubmit}}"><view class="bottom-actions data-v-32950908"><button class="ghost-btn data-v-32950908" disabled="{{currentIndex===0}}" data-event-opts="{{[['tap',[['prevQuestion',['$event']]]]]}}" bindtap="__e">上一题</button><button data-event-opts="{{[['tap',[['saveAndExit',['$event']]]]]}}" class="ghost-btn data-v-32950908" bindtap="__e">保存并退出</button><block wx:if="{{!isLastQuestion}}"><button data-event-opts="{{[['tap',[['nextQuestion',['$event']]]]]}}" class="primary-btn data-v-32950908" bindtap="__e">下一题</button></block><block wx:else><button data-event-opts="{{[['tap',[['submitTap',[false]]]]]}}" class="primary-btn data-v-32950908" bindtap="__e">提交</button></block></view></block><block wx:if="{{isSubmit&&isEndFlag}}"><view class="bottom-actions data-v-32950908"><button data-event-opts="{{[['tap',[['endClick',['$event']]]]]}}" class="primary-btn full data-v-32950908" bindtap="__e">退出</button></view></block><block wx:if="{{cardVisible}}"><view data-event-opts="{{[['tap',[['e1',['$event']]]]]}}" class="card-mask data-v-32950908" bindtap="__e"><view data-event-opts="{{[['tap',[['',['$event']]]]]}}" class="answer-card data-v-32950908" catchtap="__e"><view class="card-title data-v-32950908"><text class="data-v-32950908">题目列表</text><text data-event-opts="{{[['tap',[['e2',['$event']]]]]}}" class="card-close data-v-32950908" bindtap="__e">关闭</text></view><view class="question-grid data-v-32950908"><block wx:for="{{$root.l1}}" wx:for-item="item" wx:for-index="index" wx:key="id"><view data-event-opts="{{[['tap',[['jumpToQuestion',[index]]]]]}}" class="{{['grid-item','data-v-32950908',(item.m4)?'answered':'',(index===currentIndex)?'current':'']}}" bindtap="__e">{{''+(index+1)+''}}</view></block></view><view class="legend data-v-32950908"><text class="data-v-32950908"><text class="dot answered-dot data-v-32950908"></text>已答</text><text class="data-v-32950908"><text class="dot pending-dot data-v-32950908"></text>未答</text></view></view></view></block></view>